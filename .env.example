EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# Optional URL for your own HTTPS chat backend, not a provider URL or key.
# The bundled route is disabled until authentication, limits and a provider are configured.
# EXPO_PUBLIC_CHAT_API_URL=https://your-backend.example/api/chat
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host
STREAM_API_KEY=your_stream_api_key

# Provider keys, Clerk secret keys and Stream secrets belong only in the
# deployed server's secret manager, never in the app or an EXPO_PUBLIC_ value.
# Voice/session routes remain disabled until a secure backend is implemented.
